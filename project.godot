; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project RETH 1"
config/description="A side scrolling horror game with some life sim element to it and you need to uncover the mystery of the story yourselft"
run/main_scene="uid://be6k2qhq0icje"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

SceneManager="*uid://cwfb1jxont4t7"
Transition="*uid://burrfa5pw6bu0"
GameState="*res://Managers/game_state.gd"
EventManager="*res://Managers/event_manager.gd"
DebugHud="*res://Managers/debug_hud.gd"
PauseMenu="*res://Scene/PauseMenu.tscn"
CalendarManager="*res://Managers/calendar_manager.gd"
SchoolSummary="*res://Managers/school_summary.gd"
MobileControls="*res://Scene/MobileControls.tscn"
TimeOfDayFilter="*res://Scene/TimeOfDayFilter.tscn"
CalendarData="*res://Managers/CalendarData.gd"
ObjectiveHud="*res://Managers/objective_hud.gd"
NPCData="*res://Managers/NPCData.gd"
WeatherFilter="*res://Scene/WeatherFilter.tscn"
AudioSettings="*res://Managers/audio_settings.gd"
TimePassageTransition="*res://Scene/TimePassageTransition.tscn"
Dialogic="*uid://ds2q0uclmolvu"
GamepadFocusOverlay="*res://Scene/GamepadFocusOverlay.tscn"

[dialogic]

directories/dch_directory={
"AbangBrewok": "res://Characters/NPC/AbangBrewok.dch",
"NPC": "res://Characters/NPC/NPC.dch"
}
directories/dtl_directory={
"AbangBrewok": "res://Dialogue/AbangBrewok.dtl",
"AbangBrewok_AfterMet": "res://Dialogue/AbangBrewok_AfterMet.dtl",
"AbangBrewok_LaterDay": "res://Dialogue/AbangBrewok_LaterDay.dtl",
"test": "res://Dialogue/test.dtl"
}
layout/style_directory={
"": "res://Styles/RETH.tres",
"RETH": "res://Styles/RETH.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://Styles/RETH.tres"]
layout/default_style="res://Styles/RETH.tres"
variables={
"TestMetFlag": ""
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.03
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "SFX",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "Music",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/extended_ui/plugin.cfg")

[file_customization]

folder_colors={
"res://Areas/": "green",
"res://Assets/": "yellow",
"res://Audio/": "pink",
"res://Characters/": "teal",
"res://Dialogue/": "purple",
"res://Managers/": "yellow",
"res://Scripts/": "red",
"res://addons/": "pink",
"res://android/": "teal"
}

[global_group]

Player=""

