layout_mode = 2
bbcode_enabled = true
text = "The horizontal slider supports:
- precision editing while holding [b]shift[/b].
- scrolling with the mouse wheel.
- visible value with optional prefix/suffix.
- direct copy-paste on hover via CTRL+C and CTRL+V
- direct editing via double-click"
fit_content = true

