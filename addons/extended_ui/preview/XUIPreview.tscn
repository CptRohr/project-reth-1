layout_mode = 2
bbcode_enabled = true
text = "The Grid Panel is can draw any arbitrary grid with major and optionally minor subdivisions.

It can be relative to top-left corner or centered and an offset can be set to move the entire grid.

It includes a public [b]snap_to_grid[/b] method to snap any local position to the grid."
fit_content = true

